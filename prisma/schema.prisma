generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================
// ENUM
// ===========================

// 활동 타입
enum EventType {
  RELEASE // 음반/싱글/디지털 발매
  MUSIC_SHOW // 음악방송 출연
  CONCERT // 콘서트
  TOUR // 투어
  FANMEETING // 팬미팅
  SHOWCASE // 쇼케이스
  VARIETY_SHOW // 예능/특집/일반 TV 출연
  POPUP_STORE // 팝업 스토어
  AWARD_SHOW // 시상식 참석/수상
  CF_AD // 광고/브랜드 콜라보
  MAGAZINE // 화보/잡지 촬영
  ONLINE_CONTENT // 유튜브/Weverse/웹 콘텐츠
  MERCH_DROP // 굿즈
  ANNOUNCEMENT // 공식 발표/공지
  OTHER
}

// 음반/릴리스 타입
enum ReleaseType {
  STUDIO_ALBUM // 정규 앨범
  MINI_ALBUM // 미니 앨범
  SINGLE_ALBUM // 싱글 앨범
  DIGITAL_SINGLE // 디지털 싱글
  PARTICIPATION // OST, SMTOWN, Featuring 등 참여 음반
}

// 앨범 에디션 유형
enum EditionType {
  CD // CD-R 등
  SMART_ALBUM // NFC 등
  MUSIC_NFC_CD // SMini 등
  QR_CARD // QR 카드
}

// 주요 시장/지역
enum Market {
  KOREA
  JAPAN
  GLOBAL
}

// 주요 언어
enum Language {
  KOREAN
  JAPANESE
  ENGLISH
  OTHER
}

// 방송 프로그램 타입
enum ProgramType {
  MUSIC_SHOW
  VARIETY_SHOW
  RADIO
}

// 인증(공인판매량/출하량) 발급 기관
enum CertBody {
  RIAJ // 일본 레코드협회
  KMCA // 한국음악콘텐츠협회(Circle)
}

// 인증 등급
enum CertLevel {
  GOLD
  PLATINUM
  DOUBLE_PLATINUM
  MILLION
}

// 외부 링크 분류 (소셜/플랫폼/공식문서 등)
enum LinkType {
  OFFICIAL_SITE // 공식 사이트 (SMTOWN)
  YOUTUBE // 유튜브
  X_TWITTER // X
  INSTAGRAM // 인스타그램
  TIKTOK // 틱톡
  NAVER_TV
  SPOTIFY // 스포티파이
  AMAZON_MUSIC // 아마존 뮤직
  APPLE_MUSIC // 애플뮤직
  MELON_MUSIC // 멜론뮤직
  GENIE_MUSIC // 지니뮤직
  BUGS_MUSIC // 벅스
  FACEBOOK // 페이스북
  WEIBO // 웨이보
  BILIBILI // 빌리빌리
  WEVERSE // 위버스
  ARTICLE // 기사
  OTHER
}

// 크레딧 역할 (작사/작곡/편곡/프로듀서 등)
enum CreditRole {
  LYRICS // 작사
  COMPOSER // 작곡
  ARRANGER // 편곡
  PRODUCER // 프로듀서
  DIRECTOR // MV/비디오 감독
  PHOTOGRAPHER // 사진작가
  CHOREOGRAPHER // 안무가
  OTHER
}

// 컨텐츠(게시물/영상) 플랫폼
enum ContentPlatform {
  YOUTUBE
  WEVERSE
  NAVER_TV
  INSTAGRAM
  X_TWITTER
  TIKTOK
  BILIBILI
  FACEBOOK
  OFFICIAL_SITE
  OTHER
}

// 컨텐츠 유형(티저/비하인드/숏폼/챌린지 등)
enum ContentType {
  MV
  MV_TEASER
  DANCE_PRACTICE
  RECORDING_BEHIND
  JACKET_BEHIND
  BEHIND
  LIVE_STREAM
  SHORTS
  POSTER
  CHALLENGE
  INTERVIEW
  VARIETY_CLIP
  PERFORMANCE_CLIP
  UNBOXING
  ANNOUNCEMENT
  FANCAM
  OFFICIAL_CAM
  OTHER
}

// 가사 표기 스크립트 유형
enum ScriptType {
  NATIVE // 원문 (한국어/일본어 등)
  ROMANTIZED // 로마자 표기
  TRANSLATION // 번역문
}

// 통화 (앨범 버전 가격 등)
enum Currency {
  KRW
  JPY
  USD
  EUR
}

// ===========================
// CORE MODELS
// ===========================

// === 1. GROUP (그룹 기본 정보) ===
model Group {
  id   String @id @default(cuid())
  slug String @unique // URL 식별자

  // --- a. 기본 정보 ---
  name   String // 공식 명칭 (영문/기본): "NCT WISH"
  nameKo String? // 국문 명칭: "엔시티 위시"
  nameJa String? // 일문 명칭: "NCT WISH"

  // --- b. 기념일 ---
  debutDate     DateTime? // 정식 데뷔일
  formationDate DateTime? // 결성일

  // --- c. 팬덤 정보 ---
  fandomName String? // "NCTzen WISH"

  // --- d. OS 테마 및 비주얼 ---
  officialColor String? // "PEARL NEO CHAMPAGNE"
  logoUrl       String? // 메인 로고 이미지 URL
  iconUrl       String? // 심볼 아이콘 이미지 URL

  // --- e. 상세 정보 ---
  agency      String? // 소속사: "SM Entertainment"
  label       String? // 레이블: "Avex Trax" 등
  description String? @db.Text // 그룹 소개글

  // --- f. 관계 ---
  members       Member[]
  eras          Era[]
  albums        Album[]
  externalLinks ExternalLink[]
  contents      Content[] // 그룹 단위 컨텐츠 (공식 공지 포함)
  awards        AwardWin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === 2. MEMBER (멤버 프로필) ===
model Member {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // --- a. 핵심 신상 정보 ---
  stageName String // 활동명
  name      String? // 본명
  nameEn    String? // 로마자/영문명
  nameHanja String? // 한문 표기명

  birthDate   DateTime? // 생년월일
  nationality String? // 국적
  hometown    String? // 출신지

  // --- b. 아이돌 프로필 ---  
  positions String? // 보컬, 래퍼, 센터 등 (콤마 구분 텍스트)
  emoji     String? // 상징 이모지
  ownNumber String? // 고유 번호
  bloodType String? // 혈액형
  mbti      String? // mbti

  description String? @db.Text // 멤버 소개글/TMI

  // --- c. 비주얼 에셋 ---
  profileImageUrl String? // 프로필 사진 URL
  iconUrl         String? // 아이콘/심볼 URL
  characterUrl    String? // 위시돌 캐릭터 URL

  colorCode String? // 상징색 코드

  // --- d. 활동 메타데이터 ---
  isActive Boolean   @default(true)
  joinDate DateTime? // 데뷔일

  // --- e. 관계 ---
  events        MemberOnEvent[]
  contents      MemberOnContent[]
  externalLinks ExternalLink[]
  quotes        Quote[]
  albumEditions AlbumEdition[]
  awardWins     AwardWin[]
  appearances   Appearance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, stageName])
  @@index([groupId])
}

// === 3. ALBUM (음반/릴리스) ===
model Album {
  id   String  @id @default(cuid())
  slug String? @unique

  // --- a. 기본 메타 데이터---
  title String // 앨범명

  releaseDate DateTime // 발매일
  type        ReleaseType // 앨범 종류

  // --- b. 앨범 스펙 ---
  trackCount     Int? // 트랙 수
  totalLengthSec Int? // 전체 재생 시간 (초)

  label       String? // 레이블
  distributor String? // 유통사
  description String? @db.Text // 앨범 소개글

  // --- c. 비주얼 에셋 ---
  coverImageUrl String? // 앨범 커버 URL

  diskImageUrl  String? // CD/LP 알판 이미지
  vinylImageUrl String? // LP판 이미지

  iconUrl String? // 폴더/아이콘용 픽셀 아트 커버

  // --- d. 테마 설정 ---  
  themeColor     String? // 앨범 테마 메인 컬러
  themeTextColor String? // 테마 텍스트 컬러

  mvUrl String? // 타이틀곡 MV 공식 링크

  // --- e. 분류 ---
  market          Market   @default(KOREA)
  primaryLanguage Language @default(KOREAN)
  groupId         String?
  group           Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  isPreDebut Boolean @default(false) // Hands Up 등
  isOst      Boolean @default(false) // OST/참여 음반 구분용

  // --- f. 관계 ---
  releases       AlbumRelease[]
  tracks         Track[]
  events         EventOnAlbum[]
  chartEntries   ChartEntry[]
  certifications Certification[]
  editions       AlbumEdition[]
  credits        AlbumCredit[]
  externalLinks  ExternalLink[]
  contents       Content[]
  salesDaily     AlbumDailySales[]
  awards         AwardWin[]         @relation("AlbumAwards")
  era            Era?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([releaseDate])
  @@index([type])
  @@index([market])
}

// === ALBUM RELEASE (국가별/포맷별 상세 발매일)
model AlbumRelease {
  id String @id @default(cuid())

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  market Market // KOREA, JAPAN, GLOBAL
  date   DateTime // 해당 국가 발매일

  // 발매 형태 (PHYSICAL: 음반, DIGITAL: 음원)
  format String @default("PHYSICAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId])
  @@index([date])
}

// === 4. ALBUM EDITION (앨범 버전/사양) ===
model AlbumEdition {
  id String @id @default(cuid())

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  // --- a. 기본 정보 ---
  name        String // 버전명
  editionType EditionType? // 구분용 타입
  sku         String? // 상품번호
  isLimited   Boolean      @default(false) // 한정판 여부

  // --- b. 비주얼 에셋 ---
  coverImageUrl   String? // 해당 버전의 커버 이미지
  packageImageUrl String? // 구성품 전체 이미지

  // --- c. 구성품 정보 ---
  // 구성품(JSON: {items: ["포토북 104p", "CD-R 1종", ...]})
  components  Json?
  description String? @db.Text // 버전별 상세 설명

  // --- d. 가격 및 링크 ---
  releasePrice Int? // 발매가 (정가 기준)
  currency     Currency? // 통화
  purchaseUrl  String? // 공식 판매처/예약 링크

  // --- e. 멤버 버전 연결 ---
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId])
  @@index([memberId])
  @@index([name])
}

// === 5. TRACK (수록곡) ===
model Track {
  id      String @id @default(cuid())
  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  // --- a. 기본 정보 ---
  trackNumber Int // 트랙 번호
  title       String // 곡 제목
  durationSec Int? // 재생 시간 (초)
  genre       String? // 장르

  // --- b. 분류 플래그 ---
  isTitle      Boolean  @default(false) // 타이틀곡 여부
  isSingle     Boolean  @default(false) // 싱글 커트 여부 (이미 발매한 음반의 수록곡을 싱글로 재발매)
  isPreRelease Boolean  @default(false) // 선공개 곡 여부
  hasMv        Boolean  @default(false) // 공식 MV 유무
  language     Language @default(KOREAN)

  // 곡 개별 발매일 (선공개 곡의 경우)
  releaseDate DateTime?

  // --- c. 비주얼 & 테마 ---
  iconUrl    String? // 커스텀 아이콘 이미지 경로
  themeColor String? // 곡 전용 테마색

  // --- d. 미디어 링크 ---
  mvUrl    String? // 공식 MV 링크
  audioUrl String? // 음원 링크(스트리밍/티저 등)

  note String? // 버전 정보, 피처링 등

  originalTrackId String?
  originalTrack   Track?  @relation("TrackOriginal", fields: [originalTrackId], references: [id], onDelete: SetNull)
  versions        Track[] @relation("TrackOriginal")

  playlistTracks PlaylistTrack[]
  appearances    Appearance[]
  chartEntries   ChartEntry[]
  certifications Certification[]
  credits        TrackCredit[]
  externalLinks  ExternalLink[]
  contents       Content[]
  musicShowWins  MusicShowTrophy[]
  lyrics         TrackLyric[]
  cheeringGuide  CheeringGuide?
  awards         AwardWin[]        @relation("TrackAwards")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([albumId, trackNumber])
  @@index([albumId])
}

// === 6. TRACK LYRIC (가사) ===
model TrackLyric {
  id String @id @default(cuid())

  // --- a. 가사 데이터 ---
  text       String  @db.Text // 줄글 가사 (전체 보기용)
  lrcContent String? @db.Text // LRC 포맷 텍스트

  // --- b. 분류 ---
  language Language   @default(KOREAN)
  script   ScriptType @default(NATIVE)

  // --- c. 메타 데이터 ---
  isOfficial Boolean @default(false) // 공식 가사 여부
  copyright  String? // 저작권자
  provider   String? // 공급자

  trackId String @unique
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trackId, language, script])
  @@index([trackId, language])
}

// === 7. CHEERING GUIDE (응원법) ===
model CheeringGuide {
  id String @id @default(cuid())

  // --- a. 기본 정보 ---
  title      String? // 제목
  isOfficial Boolean @default(false) // 공식 여부

  // --- b. 컨텐츠 ---
  text     String? @db.Text // 응원법
  imageUrl String? // 응원법 이미지 URL
  videoUrl String? // 응원법 가이드 영상 URL

  // --- c. 구조화된 데이터 ---
  // 타임코드나 파트별 구분이 필요한 경우 JSON으로 저장 (선택사항)
  // 예: [ { "time": "00:15", "part": "NCT WISH!", "type": "shout" }, ... ]
  steps Json?

  // --- d. 메타 데이터 ---
  provider  String? // 출처
  sourceUrl String? // 원문 링크

  trackId String @unique
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackId])
}

// === 8. EVENT (활동/스케줄) ===
model Event {
  id String @id @default(cuid())

  // --- a. 기본 분류 및 일시 ---
  type EventType // 활동 타입

  // 날짜 관리 (단일 일정 vs 기간 일정)
  date      DateTime // 대표 날짜 (정렬 및 폴더 분류 기준)
  startDate DateTime? // 기간 시작일
  endDate   DateTime? // 기간 종료일

  // --- b. 이벤트 정보 ---
  title       String // 스케줄명
  description String? @db.Text // 상세 설명

  // 장소 정보
  location String? // 장소명
  country  String? // 국가
  city     String? // 도시

  // --- c. 비주얼 에셋 ---
  mainImageUrl  String? // 파일 썸네일용
  isHighlighted Boolean @default(false) // 중요 스케줄 강조

  // --- d. 연결 링크 ---
  relatedUrl     String? // 공식 공지/정보 링크
  ticketUrl      String? // 예매/신청 페이지 링크
  galleryAlbumId String? // 연결된 갤러리/앨범 ID

  // --- e. 관계 ---
  // 활동 시기
  eraId String?
  era   Era?    @relation(fields: [eraId], references: [id], onDelete: SetNull)

  // 시리즈
  seriesId String?
  series   EventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  // 관련 프로그램
  programName String?
  programId   String?
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  // 참여 멤버 및 연결 데이터
  albums  EventOnAlbum[]
  members MemberOnEvent[]

  // 아카이브 데이터
  appearances   Appearance[]
  externalLinks ExternalLink[]
  contents      Content[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([startDate, endDate])
  @@index([type])
  @@index([eraId])
  @@index([country])
  @@index([seriesId])
}

// === 9. EVENT SERIES (이벤트 시리즈) ===
model EventSeries {
  id String @id @default(cuid())

  // --- a. 기본 정보 ---
  name String // 시리즈명
  type EventType // 시리즈 성격 (투어, 팬미팅, 팝업스토어 등)

  // --- b. 비주얼 에셋 ---
  logoUrl   String? // 로고 이미지 (타이틀용)
  posterUrl String? // 메인 포스터 이미지 (폴더 썸네일용)

  // --- c. 상세 정보 ---
  organizer   String? // 주최/주관
  description String? @db.Text // 소개글

  // --- d. 관계 ---
  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([name])
}

// === 10. RELATION TABLES (연결 테이블) ===
// === 이벤트-앨범 N:M (쇼케이스, 발매 기념 이벤트 등 연결) ===
model EventOnAlbum {
  eventId String
  albumId String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([eventId, albumId])
  @@index([albumId])
}

// ===이벤트-멤버 N:M (출연 정보 상세) ===
model MemberOnEvent {
  memberId String
  eventId  String

  // --- a. 상세 정보 ---
  role     String? // 역할 (MC, 스페셜 게스트 등)
  isAbsent Boolean @default(false) // 불참 여부
  note     String? // 비고

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([memberId, eventId])
  @@index([eventId])
}

// === 11. ERA (활동 시기 / 테마) ===
model Era {
  id String @id @default(cuid())

  // --- a. 폴더 및 분류 정보 ---
  name        String // 폴더명
  title       String? // 화면 표시 제목
  description String? @db.Text // 시기 설명 (세계관 등)

  // --- b. 시스템 테마 ---
  isCurrent     Boolean @default(false)
  themeColor    String?
  backgroundUrl String? // 배경화면 배경 이미지
  iconUrl       String? // 커스텀 폴더 아이콘
  logoUrl       String? // 활동 로고

  // --- c. 기간 ---
  startDate DateTime
  endDate   DateTime?

  // --- d. 관계 ---
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mainAlbumId String? @unique
  mainAlbum   Album?  @relation(fields: [mainAlbumId], references: [id])
}

// ==================================
// PROGRAMS & APPEARANCES
// ==================================

// === 12. PROGRAM (방송 프로그램) ===
model Program {
  id String @id @default(cuid())

  // --- a. 기본 정보 ---
  name    String // 프로그램명
  network String? // 방송사
  country String? // 국가
  pType   ProgramType // 프로그램 종류

  // --- b. 편성 정보 (정기 스케줄용) ---
  dayOfWeek String? // 방송 요일
  airTime   String? // 방송 시간

  // --- c. 비주얼 에셋 ---
  logoUrl String? // 프로그램 공식 로고

  // --- d. 상세 정보 ---
  officialUrl String? // 공식 홈페이지/채널 링크
  notes       String? // 비고

  // --- e. 관계 ---
  appearances     Appearance[] // 출연 회차들
  musicShowTrophy MusicShowTrophy[] // 1위 기록들
  events          Event[]

  externalLinks ExternalLink[]
  contents      Content[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, country])
  @@index([pType])
}

// === 13. APPEARANCES (방송 출연 상세) ===
model Appearance {
  id String @id @default(cuid())

  // --- a. 출연 정보 ---
  date    DateTime // 출연 날짜
  title   String? // 출연 제목
  episode String? // 회차 정보
  members Member[]

  // --- b. 분류 플래그 ---
  isPerformance Boolean @default(false) // 무대/공연 여부 (무대 모아보기 필터용)
  role          String? // 역할

  // --- c. 관계 ---
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  // 연결된 활동/곡 (어떤 활동기에 무슨 노래로 출연했는지)
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  // 자료 연결
  externalLinks ExternalLink[] // 외부 영상
  contents      Content[]      @relation("AppearanceContent") // 공식 무대 영상

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([programId])
  @@index([trackId])
}

// === 14. MUSIC SHOW TROPHY (음방 1위) ===
model MusicShowTrophy {
  id String @id @default(cuid())

  // --- a. 수상 정보 ---
  date  DateTime // 수상 날짜
  score Int? // 총점

  isTripleCrown Boolean @default(false) // 트리플 크라운 여부

  // --- c. 관계 ---
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  trackId String? // 1위 곡
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId, date])
  @@index([trackId])
}

// ==================================
// CHARTS / CERTS / SALES
// ==================================

// === 15. CHART (음원/음반 차트) ===
model Chart {
  id String @id @default(cuid())

  // --- a. 차트 정보 ---
  name     String // 차트명
  provider String? // 제공사 (Melon, Oricon, Billboard 등)
  country  String? // 국가

  // --- b. 분류 ---
  // 차트 주기 (DAILY, WEEKLY, MONTHLY, REALTIME, YEARLY)
  periodType String @default("WEEKLY")

  // --- c. 비주얼 에셋 ---
  logoUrl   String? // 차트 공식 로고 이미지
  colorCode String? // 차트 상징색

  // --- d. 메타 데이터 ---
  officialUrl String? // 차트 공식 홈페이지 링크
  notes       String?

  entries ChartEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, provider, periodType])
  @@index([name])
}

// === 16. CHART ENTRY (차트 진입 기록) ===
model ChartEntry {
  id String @id @default(cuid())

  // --- a. 기록 데이터 ---
  date DateTime // 기준일
  rank Int // 순위

  // 변동 폭
  change Int? // 변동 순위
  isNew  Boolean @default(false) // 진입 여부

  // --- b. 관계 (차트) ---
  chartId String
  chart   Chart  @relation(fields: [chartId], references: [id], onDelete: Cascade)

  // --- c. 관계 (곡/앨범) ---
  albumId String?
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([chartId])
  @@index([trackId])
}

// === 17. CERTIFICATION (인증/수상) ===
model Certification {
  id String @id @default(cuid())

  // --- a. 인증 정보 ---
  body  CertBody // 인증 기관
  level CertLevel // 등급

  date  DateTime // 인증 획득일
  units Int? // 인증 기준 판매량

  // --- b. 비주얼 에셋 ---
  badgeImageUrl String? // 인증 뱃지/상패 이미지 URL

  // --- c. 관계 ---
  albumId String?
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([body, level])
  @@index([albumId])
}

// === 18. ALBUM DAILY SALES (판매량 로그) ===
model AlbumDailySales {
  id String @id @default(cuid())

  // --- a. 판매 데이터 ---
  date       DateTime // 날짜
  units      Int // 당일 판매량
  totalUnits Int? // 누적 판매량

  provider String? // 집계처

  // --- b. 메타 데이터 ---
  daySequence Int? // 발매 N일차
  note        String? // 비고

  // --- c. 관계 ---
  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([albumId, date, provider])
  @@index([albumId])
}

// ==================================
// PEOPLE & CREDITS
// ==================================

// === 19. CONTRIBUTOR (크레딧 주체) ===
model Contributor {
  id String @id @default(cuid())

  // --- a. 기본 정보 ---
  name  String // 이름
  alias String? // 이명/활동명

  description String? @db.Text // 소개글

  // --- b. 관계 ---
  trackCredits  TrackCredit[] // 참여곡
  albumCredits  AlbumCredit[] // 참여 앨범
  externalLinks ExternalLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// === 20. TRACK CREDIT (곡 크레딧 상세) ===
model TrackCredit {
  // --- a. 상세 정보 ---
  CreditRole CreditRole // 역할
  detail     String? // 세부 역할

  order Int @default(0) // 표기 순서

  // --- b. 관계 ---
  trackId       String
  contributorId String

  track       Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  contributor Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@id([trackId, contributorId])
  @@index([contributorId])
}

// === 21. ALBUM CREDIT (앨범 크레딧 상세) ===
model AlbumCredit {
  // --- a. 상세 정보 ---
  role   CreditRole // 역할
  detail String? // 세부 역할

  order Int @default(0) // 표기 순서

  // --- b. 관계 ---
  albumId       String
  contributorId String

  album       Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  contributor Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@id([albumId, contributorId])
  @@index([contributorId])
}

// ==================================
// CONTENTS (영상/게시물)
// ==================================

// === 22. CONTENT (컨텐츠) ===
// 컨텐츠(유튜브/위버스/숏폼/비하인드·티저 등 게시물 단위)
model Content {
  id String @id @default(cuid())

  // --- a. 기본 정보 ---
  title    String // 제목
  platform ContentPlatform // 플랫폼
  cType    ContentType // 유형

  url          String  @unique // 원본 링크
  thumbnailUrl String? // 썸네일 이미지

  channelName String? // 채널명
  publishedAt DateTime // 업로드 일시
  description String?  @db.Text // 영상 설명/더보기란 내용 등

  // --- b. 기능용 플래그 ---
  isHighlight Boolean @default(false)

  // --- c. 관계 ---
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // 앨범 관련
  albumId String?
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  // 활동/곡 관련
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  // 방송 관련
  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  appearanceId String?
  appearance   Appearance? @relation("AppearanceContent", fields: [appearanceId], references: [id], onDelete: SetNull)

  tags          String[]

  // 출연 멤버 & 통계
  members    MemberOnContent[]
  videoStats VideoStat[]

  // 부가 정보
  externalLinks ExternalLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform, cType])
  @@index([albumId])
  @@index([eventId])
  @@index([publishedAt])
}

// === 23. MEMBER ON CONTENT (출연 정보) ===
model MemberOnContent {
  memberId  String
  contentId String

  role String? // 역할
  note String? // 비고

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([memberId, contentId])
  @@index([contentId])
}

// === 24. VIDEO STAT (조회수 통계) ===
model VideoStat {
  id        String  @id @default(cuid())
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  snapshotAt DateTime // 기록 시점

  viewCount    BigInt // 조회수
  likeCount    BigInt? // 좋아요 수
  commentCount BigInt? // 댓글 수

  createdAt DateTime @default(now())

  @@unique([contentId, snapshotAt])
  @@index([contentId, snapshotAt])
}

// ==================================
// AWARDS (시상식/부문/수상)
// ==================================

// === 25. AWARD ORGANIZATION (시상 기관/조직) ===
model AwardOrganization {
  id String @id @default(cuid())

  // --- a. 기본 정보 ---
  name         String // 정식 명칭
  abbreviation String? // 약칭
  country      String? // 주최 국가

  // --- b. 비주얼 에셋 ---
  logoUrl String? // 주최측 공식 로고 이미지

  // --- c. 관계 ---
  events AwardEvent[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// === 26. AWARD EVENT (시상식 회차) ===
model AwardEvent {
  id             String            @id @default(cuid())
  organizationId String
  organization   AwardOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // --- a. 행사 정보 ---
  name     String // 행사명
  edition  String? // 회차
  heldAt   DateTime? // 개최일
  location String? // 장소

  // --- b. 비주얼 에셋 ---
  posterUrl String? // 해당 연도 메인 포스터 이미지
  logoUrl   String? // 해당 연도 타이틀 로고

  // --- c. 관계 ---
  categories AwardCategory[]
  wins       AwardWin[]      @relation("AwardEventWins")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([heldAt])
}

// === 27. AWARD CATEGORY (수상 부문) ===
model AwardCategory {
  id      String     @id @default(cuid())
  eventId String
  event   AwardEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // --- a. 부문 정보 ---
  name String // 부문명

  // 분류 (정렬 및 필터링용)
  type String @default("OTHER")

  // --- b. 관계 ---
  wins AwardWin[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([name])
}

// === 28. AWARD WIN (수상 실적 상세) ===
model AwardWin {
  id String @id @default(cuid())

  // --- a. 수상 내역 연결 ---
  categoryId String
  category   AwardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  eventId String?
  event   AwardEvent? @relation("AwardEventWins", fields: [eventId], references: [id], onDelete: SetNull)

  // --- b. 수상 대상 ---
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  memberId String? // 개인, 유닛 수상인 경우
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  albumId String?
  album   Album?  @relation("AlbumAwards", fields: [albumId], references: [id], onDelete: SetNull)

  trackId String?
  track   Track?  @relation("TrackAwards", fields: [trackId], references: [id], onDelete: SetNull)

  // --- c. 비주얼 & 콘텐츠 ---
  sceneImageUrl String? // 수상 장명 스틸컷
  speechUrl     String? // 수상 소감 영상 링크

  // --- d. 상세 정보 ---
  isJoint Boolean @default(false) // 공동 수상 여부
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([eventId])
  @@index([groupId])
  @@index([albumId])
  @@index([trackId])
}

// ==================================
// EXTERNAL LINKS
// ==================================

// === 29. EXTERNAL LINK (외부 링크 / 바로가기) ===
model ExternalLink {
  id String @id @default(cuid())

  // --- a. 링크 정보 ---
  type  LinkType // 플랫폼 타입
  title String? // 링크 제목
  url   String // URL 주소

  description String? // 툴팁이나 부가 설명

  // --- b. 비주얼 & 정렬 ---
  iconUrl String? // 아이콘 URL
  order   Int     @default(0) // 정렬 순서 (중요한 순으로)

  isOfficial Boolean @default(true) // 공식 링크 여부

  // --- c. 소유 및 연결 ---
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  albumId String?
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  contentId String?
  content   Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  contributorId String?
  contributor   Contributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull)

  appearanceId String?
  appearance   Appearance? @relation(fields: [appearanceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([type])
  @@index([order])
}

// ==================================
// WIDGET
// ==================================

// === 30. [Members Quote 위젯] QUOTE ===
model Quote {
  id String @id @default(cuid())

  content String

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === 31. [Wish Jar 위젯] WISH ===
model Wish {
  id String @id @default(cuid())

  content  String  @db.Text
  nickname String?
  password String? // 수정/삭제용 비밀번호 (선택사항)
  color    String // 'pink' | 'blue' | 'yellow' | 'green' | 'purple' | 'red'

  // 위치 정보
  posX     Float?
  posY     Float?
  rotation Float?

  createdAt DateTime @default(now())
}

// === 32. [Mini Player 위젯] PLAYLIST TRACK ===
model PlaylistTrack {
  id String @id @default(cuid())

  title     String
  artist    String @default("NCT WISH")
  youtubeId String // 영상 ID

  // 기존 Track과 연결
  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id])

  order    Int     @default(0) // 재생 순서
  isActive Boolean @default(true) // 노출 여부

  createdAt DateTime @default(now())
}